---
// PostCard — flat vertical card for "More reviews" grid
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getPostColor } from '../lib/colors';
import { getBandcampData } from '../lib/bandcamp';

interface Props {
  post: CollectionEntry<'blog'>;
  index?: number;
  excerpt?: string;
}

const { post, index = 99, excerpt } = Astro.props;
const slug = post.id;
const color = getPostColor(slug);
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const bc = getBandcampData(slug);
const initials = post.data.title
  .split(/[\s\-–—]+/)
  .slice(0, 2)
  .map((w: string) => w[0]?.toUpperCase() ?? '')
  .join('');
const placeholderGradientId = `post-card-gradient-${slug}`;
---

<a
  href={`${base}blog/${slug}`}
  class="post-card playlist-item"
  data-color={color.dark}
  data-post-title={post.data.title.toLowerCase()}
  data-post-date={post.data.pubDate.toISOString()}
>
  <!-- Square cover art -->
  <div class="post-card-cover">
    {bc?.coverUrl ? (
      <Image
        src={bc.coverUrl}
        alt={post.data.title}
        width={300}
        height={300}
        class="post-card-img"
        loading={index < 8 ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <div class="post-card-placeholder" aria-hidden="true">
        <svg
          class="post-card-placeholder-art"
          viewBox="0 0 100 100"
          preserveAspectRatio="none"
          focusable="false"
        >
          <defs>
            <linearGradient id={placeholderGradientId} x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color={color.dark}></stop>
              <stop offset="100%" stop-color={color.accent}></stop>
            </linearGradient>
          </defs>
          <rect width="100" height="100" fill={`url(#${placeholderGradientId})`}></rect>
          <text
            x="50"
            y="54"
            fill={color.accent}
            font-size="26"
            font-weight="700"
            text-anchor="middle"
            dominant-baseline="middle"
            font-family="JetBrains Mono, Fira Code, SF Mono, Cascadia Code, ui-monospace, monospace"
          >
            {initials}
          </text>
        </svg>
      </div>
    )}
  </div>

  <!-- Metadata -->
  <div class="post-card-title">{post.data.title}</div>
  <div class="post-card-tags">
    {post.data.tags?.slice(0, 3).join(' · ') ?? ''}
  </div>
  {excerpt && <p class="post-card-excerpt">{excerpt}</p>}
</a>

<style is:global>
  /* PostCard styles — global so both server-rendered and JS-injected cards match */
  .post-card {
    display: flex;
    flex-direction: column;
    padding: 0.5rem;
    border: 1px solid var(--theme-border);
    background-color: var(--theme-bg-elevated);
    text-decoration: none;
    transition: border-color 0.15s;
  }
  @media (min-width: 641px) {
    .post-card {
      padding: 0.75rem;
    }
  }
  .post-card:hover {
    border-color: var(--theme-accent);
  }
  .post-card:focus-visible {
    outline: 2px solid var(--theme-accent);
    outline-offset: 3px;
  }
  .post-card-cover {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    margin-bottom: 0.75rem;
  }
  .post-card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid var(--theme-border);
  }
  .post-card-placeholder {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 1px solid var(--theme-border);
  }
  .post-card-placeholder-art {
    display: block;
    width: 100%;
    height: 100%;
  }
  .post-card-title {
    display: -webkit-box;
    min-height: 2.5em;
    overflow: hidden;
    color: var(--theme-text-primary);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.25;
    text-overflow: ellipsis;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .post-card-excerpt {
    margin: 0.5rem 0 0;
    overflow: hidden;
    color: var(--theme-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  .post-card-tags {
    display: -webkit-box;
    min-height: 2.2em;
    margin-top: 0.25rem;
    overflow: hidden;
    color: var(--theme-text-muted);
    font-size: 0.75rem;
    line-height: 1.35;
    text-overflow: ellipsis;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>
