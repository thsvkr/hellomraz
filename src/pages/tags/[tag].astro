---
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import {
  getDateIndex,
  getLinkedTagNames,
  getQualifiedTagPages,
} from '../../lib/blog-data.mjs';
import { TAG_PAGE_POST_CAP } from '../../lib/feed-limits.mjs';
import { encodeTagParam } from '../../lib/tag-path';
import { getCoverThumb } from '../../lib/albums';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

export async function getStaticPaths() {
  const [tagPages, linkedTagNames] = await Promise.all([
    getQualifiedTagPages(),
    getLinkedTagNames(),
  ]);

  return tagPages.map(({ name, posts }) => ({
    params: { tag: encodeTagParam(name) },
    props: { posts, linkedTagNames, tagName: name },
  }));
}

interface Props {
  posts: CollectionEntry<'blog'>[];
  linkedTagNames: string[];
  tagName: string;
}

const { posts = [], linkedTagNames = [], tagName } = Astro.props as Props;
const tag = tagName;
const linkedTagSet = new Set<string>(linkedTagNames);
const dateIndex = await getDateIndex();
const sortedPosts = [...posts].sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const postCount = sortedPosts.length;
const postCountLabel = postCount === 1 ? 'post' : 'posts';

const relatedTags = [
  ...new Set(
    sortedPosts
      .flatMap((post) => post.data.tags || [])
      .filter((value) => value !== tag && linkedTagSet.has(value)),
  ),
].slice(0, 5);

const visiblePosts = sortedPosts.slice(0, TAG_PAGE_POST_CAP);
const hasMore = postCount > TAG_PAGE_POST_CAP;
const encodedTag = encodeTagParam(tag);
---

<Layout title={`#${tag}`}>
  <div class="min-h-full theme-surface">
    <PageHeader dateIndex={dateIndex} />

    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-8">
      <!-- Header -->
      <div class="mb-6">
        <a href={`${base}tags`} class="text-xs mb-3 inline-block theme-text-accent">
          ← tags/
        </a>

        <h1 class="text-2xl font-bold theme-text-primary">
          #{tag}
        </h1>
        <p class="text-sm mt-1 theme-text-muted">
          {postCount} {postCountLabel}
        </p>
      </div>

      <!-- Related tags -->
      {relatedTags.length > 0 && (
        <div class="mb-6 pb-4 border-b theme-border">
          <div class="flex flex-wrap gap-1.5">
            {relatedTags.map((relatedTag) => (
              <a
                href={`${base}tags/${encodeTagParam(relatedTag)}`}
                class="related-tag-chip"
              >
                #{relatedTag}
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="tag-post-controls">
        <label for="tag-post-filter">Filter reviews</label>
        <input id="tag-post-filter" type="search" placeholder="artist or album…" autocomplete="off" />
        <label for="tag-post-sort">Sort</label>
        <select id="tag-post-sort">
          <option value="newest">Newest</option>
          <option value="oldest">Oldest</option>
          <option value="title">Title</option>
        </select>
      </div>

      <!-- Posts list (capped) -->
      <div class="space-y-0" id="tag-posts-list">
        {visiblePosts.map((post) => (
          <a
            href={`${base}blog/${post.id}`}
            class="tag-post-row"
            data-post-title={post.data.title.toLowerCase()}
            data-post-date={post.data.pubDate.toISOString()}
          >
            {getCoverThumb(post.id, 'sm') ? (
              <img
                src={getCoverThumb(post.id, 'sm')}
                alt={post.data.title}
                width="72"
                height="72"
                loading="lazy"
                decoding="async"
                class="tag-post-cover"
              />
            ) : (
              <span class="tag-post-cover-placeholder" aria-hidden="true">
                {post.data.title.slice(0, 1)}
              </span>
            )}
            <span class="tag-post-content">
              <span class="tag-post-date">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' })}
              </span>
              <span class="tag-post-title">
                {post.data.title}
              </span>
            </span>
          </a>
        ))}
      </div>

      <!-- Hidden posts loaded on demand -->
      {hasMore && (
        <div class="mt-4 text-center" id="tag-show-more-wrap">
          <button
            id="tag-show-more-btn"
            class="show-more-btn"
            data-tag-param={encodedTag}
          >
            show all {postCount} posts
          </button>
        </div>
      )}

      {postCount === 0 && (
        <div class="py-8">
          <p class="text-sm theme-text-muted">no posts found.</p>
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
  .tag-post-controls {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    color: var(--theme-text-muted);
    font-size: 0.75rem;
  }
  .tag-post-controls input,
  .tag-post-controls select {
    min-height: 40px;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--theme-border);
    background: var(--theme-bg-elevated);
    color: var(--theme-text-primary);
    font: inherit;
  }
  .tag-post-controls input:focus-visible,
  .tag-post-controls select:focus-visible {
    outline: 2px solid var(--theme-accent);
    outline-offset: 2px;
  }
  .related-tag-chip {
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--theme-border);
    color: var(--theme-text-muted);
    text-decoration: none;
    transition: border-color 0.15s, color 0.15s;
  }
  .related-tag-chip:hover {
    border-color: var(--theme-accent);
    color: var(--theme-accent);
  }
  .show-more-btn {
    padding: 0.5rem 1.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    border: 1px solid var(--theme-border);
    color: var(--theme-text-muted);
    background: var(--theme-bg-elevated);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .show-more-btn:hover {
    border-color: var(--theme-accent);
    color: var(--theme-accent);
  }
  @media (max-width: 640px) {
    .tag-post-controls {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }
</style>

<style is:global>
  /* Global so dynamically inserted rows match server-rendered ones */
  .tag-post-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 88px;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--theme-border);
    color: var(--theme-text-secondary);
    text-decoration: none;
    transition: color 0.15s, background-color 0.15s;
  }
  .tag-post-row:hover {
    color: var(--theme-text-primary);
    background-color: var(--theme-bg-hover);
  }
  .tag-post-cover,
  .tag-post-cover-placeholder {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    border: 1px solid var(--theme-border);
  }
  .tag-post-cover {
    display: block;
    object-fit: cover;
  }
  .tag-post-cover-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--theme-bg-elevated), var(--theme-bg-hover));
    color: var(--theme-accent);
    font-size: 1.25rem;
    font-weight: 700;
  }
  .tag-post-content {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.375rem;
  }
  .tag-post-date {
    flex-shrink: 0;
    color: var(--theme-text-muted);
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
  }
  .tag-post-title {
    min-width: 0;
    overflow: hidden;
    color: inherit;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .tag-post-row {
      gap: 0.75rem;
      min-height: 72px;
      padding: 0.625rem 0;
    }
    .tag-post-cover,
    .tag-post-cover-placeholder {
      flex-basis: 56px;
      width: 56px;
      height: 56px;
    }
    .tag-post-title {
      display: -webkit-box;
      white-space: normal;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
  }
</style>

<script>
  function initTagPostControls() {
    const list = document.getElementById('tag-posts-list');
    const input = document.getElementById('tag-post-filter') as HTMLInputElement | null;
    const sort = document.getElementById('tag-post-sort') as HTMLSelectElement | null;
    if (!list || !input || !sort || list.dataset.controlsBound === '1') return;
    list.dataset.controlsBound = '1';

    function applyControls() {
      const query = input.value.trim().toLowerCase();
      const sortByTitle = sort.value === 'title';
      const direction = sort.value === 'oldest' ? 1 : -1;
      const rows = Array.from(list.querySelectorAll<HTMLElement>('.tag-post-row'));
      rows.sort((left, right) => {
        const attribute = sortByTitle ? 'postTitle' : 'postDate';
        const comparison = (left.dataset[attribute] || '').localeCompare(right.dataset[attribute] || '');
        return sortByTitle ? comparison : direction * comparison;
      });
      rows.forEach((row) => {
        row.hidden = !!query && !(row.dataset.postTitle || '').includes(query);
        list.appendChild(row);
      });
    }

    input.addEventListener('input', applyControls);
    sort.addEventListener('change', applyControls);
    applyControls();
  }

  function initTagShowMore() {
    const btn = document.getElementById('tag-show-more-btn') as
      | (HTMLButtonElement & { __tagShowMoreBound?: boolean })
      | null;
    const list = document.getElementById('tag-posts-list');
    const wrap = document.getElementById('tag-show-more-wrap');
    if (!btn || !list || !wrap || btn.__tagShowMoreBound) return;

    btn.__tagShowMoreBound = true;
    const tagParam = btn.dataset.tagParam!;

    btn.addEventListener('click', async () => {
      btn.textContent = 'loading…';
      try {
        const base = document.querySelector('meta[name="base-url"]')?.getAttribute('content') || '/';
        const res = await fetch(`${base}api/tag-posts/${tagParam}.json`);
        const remainingPosts: {
          slug: string;
          title: string;
          date: string;
          coverThumb?: string;
        }[] = await res.json();

        for (const post of remainingPosts) {
          const a = document.createElement('a');
          a.href = `${base}blog/${post.slug}`;
          a.className = 'tag-post-row';
          a.dataset.postTitle = post.title.toLowerCase();
          a.dataset.postDate = post.date;
          const date = new Date(post.date);

          if (post.coverThumb) {
            const cover = document.createElement('img');
            cover.className = 'tag-post-cover';
            cover.src = post.coverThumb;
            cover.alt = post.title;
            cover.width = 72;
            cover.height = 72;
            cover.loading = 'lazy';
            cover.decoding = 'async';
            a.appendChild(cover);
          } else {
            const placeholder = document.createElement('span');
            placeholder.className = 'tag-post-cover-placeholder';
            placeholder.setAttribute('aria-hidden', 'true');
            placeholder.textContent = post.title.slice(0, 1);
            a.appendChild(placeholder);
          }

          const content = document.createElement('span');
          content.className = 'tag-post-content';

          const dateSpan = document.createElement('span');
          dateSpan.className = 'tag-post-date';
          dateSpan.textContent = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' });

          const titleSpan = document.createElement('span');
          titleSpan.className = 'tag-post-title';
          titleSpan.textContent = post.title;

          content.appendChild(dateSpan);
          content.appendChild(titleSpan);
          a.appendChild(content);
          list.appendChild(a);
        }
        initTagPostControls();
        document.getElementById('tag-post-filter')?.dispatchEvent(new Event('input'));
        wrap.remove();
      } catch {
        btn.textContent = 'failed to load';
      }
    });
  }

  document.addEventListener('astro:page-load', initTagPostControls);
  document.addEventListener('astro:page-load', initTagShowMore);
  initTagPostControls();
  initTagShowMore();
</script>
