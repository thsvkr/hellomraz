---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getDateIndex } from '../lib/blog-data.mjs';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
const query = Astro.url.searchParams.get('q') ?? '';
const dateIndex = await getDateIndex();
---

<Layout title={query ? `Search: ${query}` : 'Search'}>
  <div class="search-page theme-surface">
    <PageHeader dateIndex={dateIndex} />
    <main class="search-page-content" data-search-page data-base={base} data-query={query}>
      <a href={base} class="search-back theme-text-accent">← home</a>
      <h1 class="search-title theme-text-primary">$ search</h1>
      <form class="search-page-form" role="search">
        <label for="search-page-input">Search artist or album</label>
        <div class="search-page-input-row">
          <input id="search-page-input" name="q" type="search" value={query} autocomplete="off" placeholder="artist or album…" />
          <button type="submit">search</button>
        </div>
      </form>
      <p class="search-summary theme-text-muted" data-search-summary></p>
      <div class="search-page-results" data-search-results></div>
    </main>
  </div>
</Layout>

<script>
  import {
    getSearchResultPrimaryLabel,
    getSearchResultSecondaryLabel,
    prepareSearchEntries,
    searchEntries,
  } from '../lib/search.mjs';

  type SearchEntry = {
    slug: string;
    title: string;
    artist?: string;
    album?: string;
  };

  function escapeHtml(value: string) {
    return value.replace(/[&<>"']/g, (character) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    })[character] ?? character);
  }

  async function initSearchPage() {
    const root = document.querySelector<HTMLElement>('[data-search-page]');
    if (!root || root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const input = root.querySelector<HTMLInputElement>('#search-page-input');
    const results = root.querySelector<HTMLElement>('[data-search-results]');
    const summary = root.querySelector<HTMLElement>('[data-search-summary]');
    const form = root.querySelector<HTMLFormElement>('form');
    if (!input || !results || !summary || !form) return;

    const base = root.dataset.base || '/';
    const initialQuery = new URLSearchParams(window.location.search).get('q') || '';
    input.value = initialQuery;
    let entries: ReturnType<typeof prepareSearchEntries> = [];

    try {
      const response = await fetch(`${base}api/search.json`);
      entries = prepareSearchEntries((await response.json()) as SearchEntry[]);
    } catch {
      summary.textContent = 'Search unavailable.';
      return;
    }

    function render() {
      const query = input.value.trim();
      const matches = searchEntries(entries, query, 100);
      summary.textContent = query ? `${matches.length} result${matches.length === 1 ? '' : 's'}` : 'Type to search all reviews.';
      results.innerHTML = matches.length
        ? matches.map((entry) => {
            const primary = escapeHtml(getSearchResultPrimaryLabel(entry));
            const secondary = escapeHtml(getSearchResultSecondaryLabel(entry));
            return `<a class="search-page-result" href="${base}blog/${encodeURIComponent(entry.slug).replace(/%2F/g, '/')}">
              <span class="search-page-result-title">${primary}</span>
              ${secondary ? `<span class="search-page-result-secondary">${secondary}</span>` : ''}
            </a>`;
          }).join('')
        : query ? '<p class="search-empty theme-text-muted">No matching reviews.</p>' : '';
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const next = new URL(window.location.href);
      next.searchParams.set('q', input.value.trim());
      window.history.replaceState({}, '', next);
      render();
    });
    input.addEventListener('input', render);
    render();
  }

  document.addEventListener('astro:page-load', initSearchPage);
  initSearchPage();
</script>

<style>
  .search-page-content {
    width: min(100%, 52rem);
    margin-inline: auto;
    padding: 2rem 1rem 4rem;
  }
  .search-back {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    text-decoration: none;
  }
  .search-title {
    margin: 1rem 0 1.5rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }
  .search-page-form label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--theme-text-muted);
    font-size: 0.875rem;
  }
  .search-page-input-row {
    display: flex;
    gap: 0.5rem;
  }
  .search-page-input-row input {
    min-width: 0;
    flex: 1;
    min-height: 46px;
    padding: 0.75rem;
    border: 1px solid var(--theme-border);
    background: var(--theme-bg-elevated);
    color: var(--theme-text-primary);
    font: inherit;
  }
  .search-page-input-row button {
    min-height: 46px;
    padding: 0 1rem;
    border: 1px solid var(--theme-border);
    background: var(--theme-bg-hover);
    color: var(--theme-text-primary);
    font: inherit;
    cursor: pointer;
  }
  .search-page-input-row input:focus-visible,
  .search-page-input-row button:focus-visible,
  .search-page-result:focus-visible {
    outline: 2px solid var(--theme-accent);
    outline-offset: 3px;
  }
  .search-summary {
    margin: 1.5rem 0 0.75rem;
    font-size: 0.875rem;
  }
  .search-page-results {
    display: grid;
    gap: 0.5rem;
  }
  .search-page-result {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--theme-border);
    background: var(--theme-bg-elevated);
    color: var(--theme-text-primary);
    text-decoration: none;
  }
  .search-page-result:hover {
    border-color: var(--theme-accent);
  }
  .search-page-result-title {
    font-weight: 600;
  }
  .search-page-result-secondary {
    color: var(--theme-text-muted);
    font-size: 0.8125rem;
  }
  .search-empty {
    padding: 1rem 0;
  }
  @media (max-width: 640px) {
    .search-page-input-row {
      flex-direction: column;
    }
  }
</style>
