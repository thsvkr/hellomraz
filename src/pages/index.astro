---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PostCard from '../components/PostCard.astro';

import { getDateIndex, getRecentPosts } from '../lib/blog-data.mjs';
import { getAllVideos } from '../lib/videos';
import { HOME_REVIEW_INITIAL_POSTS } from '../lib/feed-limits.mjs';
import { VIDEO_STRIP_INITIAL } from '../lib/video-config.mjs';

const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

const [dateIndex, morePosts, allVideos] = await Promise.all([
  getDateIndex(),
  getRecentPosts(HOME_REVIEW_INITIAL_POSTS),
  Promise.resolve(getAllVideos()),
]);
const initialVideos = allVideos.slice(0, VIDEO_STRIP_INITIAL);
const latestPost = morePosts[0];
const latestExcerpt = latestPost
  ? (latestPost.data.description || String(latestPost.body ?? ''))
      .replace(/[#*_`>\[\]]/g, '')
      .replace(/\s+/g, ' ')
      .trim()
      .slice(0, 240)
  : '';
---

<Layout title="Home">
  <PageHeader dateIndex={dateIndex} />

  <div id="playlist-container" class="theme-surface">
  {latestPost && (
    <section
      class="latest-review theme-surface"
      aria-labelledby="latest-review-heading"
      data-latest-slug={latestPost.id}
      data-latest-excerpt={latestExcerpt}
    >
      <div class="section-heading-row">
        <h1 id="latest-review-heading" class="text-lg font-bold theme-text-primary">~ latest drop</h1>
        <span class="text-sm theme-text-muted">{latestPost.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
      </div>
      <div class="featured-review">
        <PostCard post={latestPost} index={0} excerpt={latestExcerpt} />
      </div>
      <script is:inline>
        (() => {
          const section = document.currentScript?.closest('[data-latest-slug]');
          if (!section || section.dataset.languageBound === '1') return;
          section.dataset.languageBound = '1';

          let requestId = 0;
          const updateExcerpt = async () => {
            const currentRequest = ++requestId;
            const excerpt = section.querySelector('.post-card-excerpt');
            if (!excerpt) return;

            const { latestSlug: slug = '', latestExcerpt: original = '' } = section.dataset;
            const lang = localStorage.getItem('site-lang') || 'ru';
            const applyExcerpt = (text) => {
              if (currentRequest === requestId) excerpt.textContent = text;
            };

            if (lang === 'ru') {
              applyExcerpt(original);
              return;
            }

            try {
              const base = document.querySelector('meta[name="base-url"]')?.getAttribute('content') || '/';
              const response = await fetch(`${base}i18n/${lang}/posts/${slug}.txt`);
              const translated = response.ok ? (await response.text()).trim() : '';
              applyExcerpt(translated || original);
            } catch {
              applyExcerpt(original);
            }
          };

          window.addEventListener('lang-changed', updateExcerpt);
          updateExcerpt();
        })();
      </script>
    </section>
  )}

  <section class="reviews-section theme-surface" aria-labelledby="reviews-heading">
    <div class="reviews-header">
      <button
        id="reviews-header-toggle"
        class="reviews-toggle"
        type="button"
        aria-expanded="true"
        aria-controls="reviews-body"
      >
        <h2 id="reviews-heading" class="text-lg font-bold theme-text-primary">~ reviews</h2>
        <span class="reviews-chevron" aria-hidden="true">▾</span>
      </button>
      <a
        href={`${base}blog`}
        class="reviews-link text-sm font-medium touch-target-inline theme-text-accent"
      >
        see all →
      </a>
    </div>
    <div class="reviews-body" id="reviews-body">
      <div
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-2 sm:gap-3"
        id="more-reviews-grid"
        data-base={base}
      >
        {morePosts.slice(1).map((post, i) => (
          <PostCard post={post} index={i + 1} />
        ))}
      </div>

      <div class="flex justify-center mt-6" id="load-more-reviews-wrap">
        <button
          id="load-more-reviews-btn"
          class="load-more-reviews-btn"
          type="button"
        >
          load more
        </button>
      </div>
    </div>
  </section>

  {initialVideos.length > 0 && (
    <aside class="videos-drawer videos-collapsed theme-border" id="home-videos-strip" aria-labelledby="videos-heading">
      <div class="videos-drawer-tab">
        <button
          id="videos-strip-toggle"
          class="videos-strip-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="home-videos-scroll"
        >
          <span id="videos-heading">videos</span>
          <span class="videos-strip-chevron" aria-hidden="true">▾</span>
        </button>
      </div>
      <div class="videos-drawer-panel">
        <div class="videos-drawer-toolbar">
          <span class="text-lg font-bold theme-text-primary">~ videos</span>
          <a href={`${base}videos`} class="videos-strip-link text-sm font-medium touch-target-inline theme-text-accent">see all →</a>
        </div>
        <div class="videos-strip-body" id="home-videos-scroll">
          {initialVideos.map((v, i) => (
            <a
              href={`${base}videos/${v.youtubeId}`}
              class="video-strip-card"
              data-youtube-id={v.youtubeId}
            >
              <div class="video-strip-thumb">
                <img
                  src={`https://i.ytimg.com/vi/${v.youtubeId}/hqdefault.jpg`}
                  alt={v.title}
                  width={320}
                  height={180}
                  loading={i < 4 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <div class="video-strip-play" aria-hidden="true">▶</div>
              </div>
              <span class="video-strip-title">{v.title}</span>
            </a>
          ))}
        </div>
      </div>
    </aside>
  )}
  </div>

</Layout>

<script>
  const drawer = document.getElementById('home-videos-strip');
  if (drawer) {
    const isOpen = localStorage.getItem('hellomraz-videos-collapsed') === '0';
    drawer.classList.toggle('videos-collapsed', !isOpen);
    drawer.classList.add('videos-drawer-ready');
  }
</script>

<script>
  interface ReviewPost {
    slug: string;
    title: string;
    tags: string[];
    coverLg: string | null;
    colorDark: string;
    colorAccent: string;
    initials: string;
  }

  const BATCH = 12;
  let allPosts: ReviewPost[] | null = null;
  let loaded = 0;

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function renderCard(post: ReviewPost, base: string): string {
    const safeTitle = escapeHtml(post.title);
    const safeInitials = escapeHtml(post.initials);
    const gradientId = `post-card-gradient-${post.slug}`;
    const cover = post.coverLg
      ? `<img src="${post.coverLg}" alt="${safeTitle}" width="300" height="300"
           class="post-card-img" loading="lazy" decoding="async">`
      : `<div class="post-card-placeholder" aria-hidden="true">
           <svg class="post-card-placeholder-art" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
             <defs>
               <linearGradient id="${gradientId}" x1="0%" y1="0%" x2="100%" y2="100%">
                 <stop offset="0%" stop-color="${post.colorDark}"></stop>
                 <stop offset="100%" stop-color="${post.colorAccent}"></stop>
               </linearGradient>
             </defs>
             <rect width="100" height="100" fill="url(#${gradientId})"></rect>
             <text x="50" y="54" fill="${post.colorAccent}" font-size="26" font-weight="700" text-anchor="middle" dominant-baseline="middle" font-family="JetBrains Mono, Fira Code, SF Mono, Cascadia Code, ui-monospace, monospace">${safeInitials}</text>
           </svg>
         </div>`;

    const tags = post.tags.slice(0, 3).join(' · ');

    return `<a href="${base}blog/${post.slug}"
      class="post-card playlist-item" data-color="${post.colorDark}">
      <div class="post-card-cover">${cover}</div>
      <div class="post-card-title">${safeTitle}</div>
      <div class="post-card-tags">${tags}</div>
    </a>`;
  }

  async function fetchPosts(): Promise<ReviewPost[]> {
    if (allPosts) return allPosts;
    const grid = document.getElementById('more-reviews-grid');
    const base = grid?.dataset.base || '/';
    const res = await fetch(`${base}api/review-cards.json`);
    allPosts = await res.json();
    return allPosts!;
  }

  function initMoreReviews() {
    const btn = document.getElementById('load-more-reviews-btn');
    const wrap = document.getElementById('load-more-reviews-wrap');
    const grid = document.getElementById('more-reviews-grid');
    if (!btn || !wrap || !grid) return;

    if ((btn as any).__bound) return;
    (btn as any).__bound = true;

    loaded = 0;
    wrap.hidden = false;
    btn.textContent = 'load more';

    btn.addEventListener('click', async () => {
      btn.textContent = 'loading…';
      const posts = await fetchPosts();
      const base = grid.dataset.base || '/';
      const end = Math.min(loaded + BATCH, posts.length);

      if (loaded >= posts.length) {
        wrap.hidden = true;
        return;
      }

      grid.insertAdjacentHTML(
        'beforeend',
        posts.slice(loaded, end).map((post) => renderCard(post, base)).join(''),
      );
      loaded = end;

      if (loaded >= posts.length) {
        wrap.hidden = true;
      } else {
        btn.textContent = 'load more';
      }
    });
  }

  document.addEventListener('astro:page-load', initMoreReviews);
  initMoreReviews();
</script>

<style>
  .reviews-section {
    padding: 2rem 1.5rem 2.5rem;
    padding-bottom: calc(2.5rem + env(safe-area-inset-bottom, 0px));
  }
  @media (min-width: 640px) {
    .reviews-section {
      padding: 2rem 2.5rem 2.5rem;
      padding-bottom: calc(2.5rem + env(safe-area-inset-bottom, 0px));
    }
  }
  .latest-review {
    padding: 1.5rem 1.5rem 0;
  }
  .section-heading-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    max-width: 72rem;
    margin: 0 auto 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--theme-border);
  }
  .featured-review {
    max-width: 72rem;
    margin-inline: auto;
  }
  .featured-review :global(.post-card) {
    display: grid;
    grid-template-columns: minmax(11rem, 18rem) minmax(0, 1fr);
    grid-template-rows: auto auto auto;
    gap: 0.75rem 1.25rem;
    padding: 1rem;
  }
  .featured-review :global(.post-card-cover) {
    grid-column: 1;
    grid-row: 1 / -1;
    margin-bottom: 0;
  }
  .featured-review :global(.post-card-title) {
    grid-column: 2;
    grid-row: 1;
    align-self: end;
    min-height: 0;
    font-size: clamp(1rem, 2vw, 1.5rem);
    line-height: 1.25;
    -webkit-line-clamp: 3;
  }
  .featured-review :global(.post-card-tags) {
    grid-column: 2;
    grid-row: 2;
    align-self: start;
    min-height: 0;
  }
  .featured-review :global(.post-card-excerpt) {
    grid-column: 2;
    grid-row: 3;
    align-self: start;
  }
  @media (max-width: 639px) {
    .latest-review {
      padding-inline: 0.75rem;
    }

    .featured-review :global(.post-card) {
      display: flex;
      gap: 0;
    }

    .featured-review :global(.post-card-cover) {
      margin-bottom: 0.75rem;
    }
  }

  .load-more-reviews-btn {
    padding: 0.75rem 1.25rem;
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid var(--theme-border);
    color: var(--theme-text-secondary);
    background: var(--theme-bg-elevated);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .load-more-reviews-btn:hover,
  .load-more-reviews-btn:focus-visible {
    border-color: var(--theme-accent);
    color: var(--theme-accent);
  }

  /* ── Videos right drawer ── */
  .videos-drawer {
    position: fixed;
    top: 5rem;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 900;
    display: flex;
    width: min(28rem, calc(100vw - 1.5rem));
    border: 1px solid var(--theme-border);
    background: var(--theme-bg-surface);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.28);
    transition: transform 0.2s ease;
  }
  .videos-drawer:not(.videos-drawer-ready) {
    visibility: hidden;
    transition: none;
  }
  .videos-drawer.videos-collapsed {
    transform: translateX(calc(100% - 2.75rem));
  }
  @media (max-width: 640px) {
    .videos-drawer {
      top: auto;
      bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
      height: min(70vh, 32rem);
    }
  }
  .videos-drawer-tab {
    flex: 0 0 2.75rem;
    border-right: 1px solid var(--theme-border);
    background: var(--theme-bg-elevated);
  }
  .videos-strip-toggle {
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0.5rem;
    border: 0;
    background: transparent;
    color: var(--theme-text-secondary);
    font: inherit;
    cursor: pointer;
  }
  .videos-strip-toggle > span:first-child {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .videos-drawer-panel {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    padding: 1rem;
  }
  .videos-drawer-toolbar,
  .reviews-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--theme-border);
  }
  .reviews-toggle {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .videos-strip-toggle:hover,
  .reviews-toggle:hover,
  .videos-strip-toggle:focus-visible,
  .reviews-toggle:focus-visible {
    color: var(--theme-accent);
  }
  .videos-strip-toggle:focus-visible,
  .reviews-toggle:focus-visible,
  .videos-strip-link:focus-visible,
  .reviews-link:focus-visible {
    outline: 2px solid var(--theme-accent);
    outline-offset: 3px;
  }

  .videos-strip-body {
    display: grid;
    flex: 1;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .videos-drawer.videos-collapsed .videos-drawer-panel {
    visibility: hidden;
  }

  /* Chevron */
  .videos-strip-chevron {
    font-size: 1.25rem;
    color: var(--theme-text-muted);
    transition: transform 0.2s ease, color 0.15s;
  }
  #videos-strip-toggle[aria-expanded="false"] .videos-strip-chevron {
    transform: rotate(-90deg);
  }

  .reviews-chevron {
    font-size: 1.25rem;
    color: var(--theme-text-muted);
    transition: transform 0.2s ease, color 0.15s;
  }
  #reviews-header-toggle[aria-expanded="false"] .reviews-chevron {
    transform: rotate(-90deg);
  }
  .reviews-body {
    overflow: hidden;
    max-height: 100000px;
    transition: max-height 0.3s ease, opacity 0.2s ease;
    opacity: 1;
  }
  .reviews-body.reviews-collapsed {
    max-height: 0 !important;
    opacity: 0;
    pointer-events: none;
  }

  .video-strip-card {
    width: 100%;
    min-width: 0;
    max-width: none;
    scroll-snap-align: start;
    text-decoration: none;
    transition: transform 0.15s;
  }
  .video-strip-card:hover {
    transform: scale(1.03);
  }
  .video-strip-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--theme-border);
    background-color: var(--theme-bg-elevated);
  }
  .video-strip-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .video-strip-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.35);
    color: #fff;
    font-size: 1.75rem;
    opacity: 0;
    transition: opacity 0.15s;
    pointer-events: none;
  }
  .video-strip-card:hover .video-strip-play {
    opacity: 1;
  }
  .video-strip-title {
    display: block;
    margin-top: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--theme-text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

<script>
  function bindColorCards() {
    const container = document.getElementById('playlist-container');
    const grid = document.getElementById('more-reviews-grid') as
      | (HTMLElement & {
          __colorCardsBound?: boolean;
        })
      | null;
    if (!container || !grid || grid.__colorCardsBound) return;

    grid.__colorCardsBound = true;

    function setColor(color: string) {
      const current = container.getAttribute('data-color');
      if (color && color !== current) {
        container.style.setProperty('--context-color', color);
        container.setAttribute('data-color', color);
      }
    }

    let timeout: ReturnType<typeof setTimeout> | null = null;

    grid.addEventListener('mouseover', (event) => {
      const card = (event.target as HTMLElement).closest<HTMLElement>('.playlist-item');
      if (!card) return;

      const related = event.relatedTarget;
      if (related instanceof Node && card.contains(related)) return;

      const color = card.getAttribute('data-color');
      if (!color) return;

      if (timeout) clearTimeout(timeout);
      timeout = setTimeout(() => setColor(color), 200);
    });

    grid.addEventListener('mouseout', (event) => {
      const card = (event.target as HTMLElement).closest<HTMLElement>('.playlist-item');
      if (!card) return;

      const related = event.relatedTarget;
      if (related instanceof Node && card.contains(related)) return;

      if (timeout) {
        clearTimeout(timeout);
        timeout = null;
      }
    });

    grid.addEventListener('focusin', (event) => {
      const card = (event.target as HTMLElement).closest<HTMLElement>('.playlist-item');
      if (!card) return;
      const color = card.getAttribute('data-color');
      if (color) setColor(color);
    });
  }

  document.addEventListener('astro:page-load', bindColorCards);
  bindColorCards();

  /* ── Videos strip collapsible ── */
  function initVideosStrip() {
    const strip = document.getElementById('home-videos-strip');
    if (!strip) return;

    const toggle = strip.querySelector<HTMLButtonElement>('#videos-strip-toggle');
    if (!toggle) return;

    // Restore state from localStorage every init (DOM may have been swapped)
    const collapsed = localStorage.getItem('hellomraz-videos-collapsed') !== '0';
    strip.classList.toggle('videos-collapsed', collapsed);
    strip.classList.add('videos-drawer-ready');
    toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');

    // Idempotent click binding — guard against double init (module eval + astro:page-load)
    if (toggle.dataset.bound === '1') return;
    toggle.dataset.bound = '1';

    toggle.addEventListener('click', () => {
      const isCollapsed = strip.classList.toggle('videos-collapsed');
      toggle.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
      localStorage.setItem('hellomraz-videos-collapsed', isCollapsed ? '1' : '0');
    });
  }

  document.addEventListener('astro:page-load', initVideosStrip);
  initVideosStrip();

  /* ── Reviews section collapsible ── */
  function initReviewsToggle() {
    const toggle = document.getElementById('reviews-header-toggle');
    const body = document.getElementById('reviews-body');
    if (!toggle || !body) return;

    const collapsed = localStorage.getItem('hellomraz-reviews-collapsed') === '1';
    body.classList.toggle('reviews-collapsed', collapsed);
    toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');

    if (toggle.dataset.bound === '1') return;
    toggle.dataset.bound = '1';

    toggle.addEventListener('click', (e) => {
      // Don't toggle if user clicked the "see all" link
      if ((e.target as HTMLElement).closest('a')) return;
      const isCollapsed = body.classList.toggle('reviews-collapsed');
      toggle.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
      localStorage.setItem('hellomraz-reviews-collapsed', isCollapsed ? '1' : '0');
    });
  }

  document.addEventListener('astro:page-load', initReviewsToggle);
  initReviewsToggle();
</script>
